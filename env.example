# Copie este arquivo para .env.local (uso local) e/ou configure estas
# variáveis em Vercel > Project Settings > Environment Variables

# Senha única que você vai compartilhar com quem tiver permissão de usar o app
ADMIN_PASSWORD=troque-por-uma-senha-forte

# E-mail que terá acesso ao Painel Administrativo (log de acessos)
ADMIN_EMAIL=ocodigodavendahumana@gmail.com

# Chave secreta usada para assinar o cookie de sessão — gere uma string
# aleatória longa, por exemplo com: openssl rand -hex 32
SESSION_SECRET=gere-uma-string-aleatoria-longa-aqui

# KV_REST_API_URL e KV_REST_API_TOKEN são preenchidas automaticamente pela
# Vercel quando você conecta um banco Vercel KV ao projeto — não precisa
# copiar manualmente.
